#!/usr/bin/env bash
# Predicts the lab backtest's rps ladder (simulator-spec.md sections 7.2 and 7.3): for every target scenario of the scenario file, the
# utilisation of the database CPU at each of the 13 stages (15 when every target scenario is s-1 .. s-5, section 7.4.2) (point and safe side), the naive estimate, and the limit rps (point, safe, naive).
# Writes ladder-prediction.json. Sends no request, touches no database and no app.
#
#   poc/lab/bin/predict-ladder --estimate=<estimate dir> --scenario=<scenario.yaml> --out=<output dir> --naive-count=<rows>
#       [--safe-estimate=<estimate dir> ...] [--estimate-commit=<hash>] [--expect-estimate-commit=<hash>]
#       [--drop-marked-routes [--request-timeout-s=<seconds>] [--warmup-from-marks]]
#
# --naive-count=<rows> is N_0, the count of rows the naive estimate (section 7.3) is chosen at, e.g. --naive-count=10000: only the calibration
# scenarios at exactly that count are candidates (cal-4, cal-5 and any other count are not). It is required and has no default: without it, or with
# no calibration scenario at it, this stops (exit 37).
# The scenario file is the form of section 3.4: the calibration scenarios with `observed`, and the target scenarios, whose rps give the mix of
# routes (the stages rescale it). The calibration and the utilisation of a stage are the parts of bin/simulate; nothing is calculated here.
# The point of every route is the one formula of --estimate. The marks (and so the safe side) are those of the estimate made at the count of rows
# the target scenario reads: --estimate's own if it was made at that count, else one of the --safe-estimate directories (repeatable; one per
# count, each also committed and unchanged). A target scenario whose count has no estimate stops this (exit 35); the output says which estimate's
# marks each scenario got. A calibration scenario that is a record only (cal-3-orig) stops it (34); so does a calibration coefficient cut to 0 (33).
# The commit of an estimate is the last commit that touched its directory (git); each must be committed and unchanged, or this
# stops (exit 3). --estimate-commit=<hash> says the main one's instead (recorded as coming from the argument): for a trial run on a scratch estimate.
# --expect-estimate-commit=<hash> (default 7c40774, the estimate the lab predicts from) is the commit --estimate must come from by git; the output
# and the summary say whether it does (a mismatch is recorded, it does not stop).
# --drop-marked-routes (off by default; without it the output is byte for byte what it always was) is the allocation of test B (simulator-spec.md
# section 7.4.4): the routes that the placeholder side or the memory side of the mark flags at the scenario's count (the scenario file must give
# `db_placeholder_limit` and `app_memory_limit`) are taken out of every target scenario's mix, and their share goes to the other routes of the same group
# (the routes that carry the same rps in the file) in proportion to their rps; the sum of rps, so the naive estimate, stays. Each scenario's `allocation` block
# in the output says which routes were taken out, why, and the rps before and after. It stops with no prediction (exit 38) when a group is left with no
# route, (39) when the php CPU time the model gives for one request of any route is above half of --request-timeout-s (default 1800, so over 900 s;
# exactly 900 passes), or (40) when a limit it needs is not in the scenario file.
# --warmup-from-marks (off by default; only with --drop-marked-routes, else exit 2; without it the output is byte for byte what it was) is the length of the discarded
# start of a step of the sixth B (simulator-spec.md section 7.4.5): every stage of every scenario gets `warmup_sec` (a whole number of seconds, at least 60) and
# `warmup_basis` (`route` and `upper_bound_sec`): the largest, over the routes that stay in the mix after the allocation, of the upper bound of one request's time that the
# CPU-time mark gives (php_cpu_over_db x the larger of the point and the safe reading of the database time of one request), rounded up. It is worked out from the
# prediction alone. A bound over 900 s (half of the request timeout) stops the run with exit 39 and no prediction, as in section 7.4.4. The top of the output
# has a `warmup` block with the rule.
# Uses the PHP on this machine if there is one; otherwise a throwaway container of the already built PHP image, no network, the inputs
# mounted read-only and only the output directory writable. The image is never pulled.
# exit codes: 0 done / 2 wrong usage / 3 an estimate is not committed and unchanged (and no --estimate-commit for the main one) / 11 no PHP and
# no image / 20..25, 1 as bin/simulate / 30 the calibration cannot be made / 32 no target scenario / 33 a calibration coefficient was cut /
# 34 a record-only scenario is a calibration scenario / 35 a target scenario has no estimate at its count / 36 the estimates disagree /
# 37 no calibration scenario is at N_0 (--naive-count) / 38 a group is left with no route / 39 a request is over half of the request timeout /
# 40 --drop-marked-routes without a placeholder limit or a memory limit in the scenario file
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
runtime="$(cd "$here/../../runtime" && pwd)"
usage="usage: poc/lab/bin/predict-ladder --estimate=<estimate dir> --scenario=<scenario.yaml> --out=<output dir> --naive-count=<rows> [--safe-estimate=<estimate dir> ...] [--estimate-commit=<hash>] [--expect-estimate-commit=<hash>] [--drop-marked-routes [--request-timeout-s=<seconds>] [--warmup-from-marks]]"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '2,42p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 0
fi

estimate=""
scenario=""
out=""
commit=""
expected="7c40774"
naive_count=""
drop=0
timeout_s=""
warmup=0
safe=()
for arg in "$@"; do
  case "$arg" in
    --estimate=*) estimate="${arg#--estimate=}" ;;
    --safe-estimate=*) safe+=("${arg#--safe-estimate=}") ;;
    --expect-estimate-commit=*) expected="${arg#--expect-estimate-commit=}" ;;
    --scenario=*) scenario="${arg#--scenario=}" ;;
    --out=*) out="${arg#--out=}" ;;
    --naive-count=*) naive_count="${arg#--naive-count=}" ;;
    --drop-marked-routes) drop=1 ;;
    --warmup-from-marks) warmup=1 ;;
    --request-timeout-s=*) timeout_s="${arg#--request-timeout-s=}" ;;
    --estimate-commit=*) commit="${arg#--estimate-commit=}" ;;
    *) echo "predict-ladder: unknown argument: $arg" >&2; echo "$usage" >&2; exit 2 ;;
  esac
done
if [ ! -d "$estimate" ]; then echo "predict-ladder: --estimate is not a directory" >&2; echo "$usage" >&2; exit 2; fi
if [ ! -f "$scenario" ]; then echo "predict-ladder: --scenario is not a readable file" >&2; echo "$usage" >&2; exit 2; fi
if [ -z "$out" ]; then echo "predict-ladder: --out is required" >&2; echo "$usage" >&2; exit 2; fi
if ! [[ "$naive_count" =~ ^[1-9][0-9]*$ ]]; then echo "predict-ladder: --naive-count=<rows> (N_0) is required, a positive whole number" >&2; echo "$usage" >&2; exit 2; fi
if [ -n "$timeout_s" ] && [ "$drop" != 1 ]; then echo "predict-ladder: --request-timeout-s is for --drop-marked-routes only" >&2; echo "$usage" >&2; exit 2; fi
if [ "$warmup" = 1 ] && [ "$drop" != 1 ]; then echo "predict-ladder: --warmup-from-marks is for --drop-marked-routes only" >&2; echo "$usage" >&2; exit 2; fi
drop_opts=()
if [ "$drop" = 1 ]; then drop_opts+=(--drop-marked-routes); [ -z "$timeout_s" ] || drop_opts+=("--request-timeout-s=$timeout_s"); [ "$warmup" != 1 ] || drop_opts+=(--warmup-from-marks); fi
mkdir -p "$out"
estimate="$(cd "$estimate" && pwd)"
scenario="$(cd "$(dirname "$scenario")" && pwd)/$(basename "$scenario")"
out="$(cd "$out" && pwd)"

source="argument"
if [ -z "$commit" ]; then
  source="git"
  if ! commit="$(git -C "$estimate" log -1 --format=%H -- . 2>/dev/null)" || [ -z "$commit" ]; then
    echo "predict-ladder: the estimate directory is not in a git history (commit it first, or give --estimate-commit=<hash>)" >&2
    exit 3
  fi
  if [ -n "$(git -C "$estimate" status --porcelain -- . 2>/dev/null)" ]; then
    echo "predict-ladder: the estimate directory has changes that are not committed" >&2
    exit 3
  fi
fi

# The safe-side estimates: each a committed, unchanged directory of its own, with its commit found by git (no way to say it by hand).
safe_dirs=()
safe_args=()
for d in "${safe[@]+"${safe[@]}"}"; do
  if [ ! -d "$d" ]; then echo "predict-ladder: --safe-estimate is not a directory: $d" >&2; echo "$usage" >&2; exit 2; fi
  d="$(cd "$d" && pwd)"
  if ! sc="$(git -C "$d" log -1 --format=%H -- . 2>/dev/null)" || [ -z "$sc" ]; then
    echo "predict-ladder: a --safe-estimate directory is not in a git history (commit it first)" >&2
    exit 3
  fi
  if [ -n "$(git -C "$d" status --porcelain -- . 2>/dev/null)" ]; then
    echo "predict-ladder: a --safe-estimate directory has changes that are not committed" >&2
    exit 3
  fi
  safe_dirs+=("$d")
  safe_args+=("$sc")
done

if command -v php >/dev/null 2>&1; then
  safe_opts=()
  for i in "${!safe_dirs[@]}"; do safe_opts+=("--safe-estimate=${safe_dirs[$i]}::${safe_args[$i]}::git"); done
  exec php "$runtime/bin/inner/predict-ladder.php" --estimate="$estimate" --scenario="$scenario" --out="$out" \
    --estimate-commit="$commit" --estimate-commit-source="$source" --require-marks-at-count \
    --naive-count="$naive_count" --expect-estimate-commit="$expected" "${drop_opts[@]+"${drop_opts[@]}"}" "${safe_opts[@]+"${safe_opts[@]}"}"
fi

image="${PEAK_PHP_IMAGE:-peak-measure-php:${PHP_VERSION:-8.3}}"
if ! docker image inspect "$image" >/dev/null 2>&1; then
  echo "predict-ladder: no php on this machine and no image $image (build it with bin/stack build-image)" >&2
  exit 11
fi
mounts=()
safe_opts=()
for i in "${!safe_dirs[@]}"; do
  mounts+=(-v "${safe_dirs[$i]}:/input/safe/$i:ro")
  safe_opts+=("--safe-estimate=/input/safe/$i::${safe_args[$i]}::git")
done
exec docker run --rm --pull=never --network none --read-only --user "$(id -u):$(id -g)" \
  -v "$runtime:/runtime:ro" -v "$estimate:/input/estimate:ro" -v "$scenario:/input/scenario.yaml:ro" -v "$out:/output" \
  "${mounts[@]+"${mounts[@]}"}" \
  "$image" php /runtime/bin/inner/predict-ladder.php --estimate=/input/estimate --scenario=/input/scenario.yaml --out=/output \
  --estimate-commit="$commit" --estimate-commit-source="$source" --require-marks-at-count \
  --naive-count="$naive_count" --expect-estimate-commit="$expected" "${drop_opts[@]+"${drop_opts[@]}"}" "${safe_opts[@]+"${safe_opts[@]}"}"
