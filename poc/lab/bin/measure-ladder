#!/usr/bin/env bash
# Measures one prediction scenario (t-1 .. t-5) on the lab, step by step up the rps ladder (docs/simulator-spec.md section 7.2).
#
#   poc/lab/bin/measure-ladder --scenario=<t-1..t-5> --predictions=<poc/lab/predictions/....json> [--switch-scale] [--out=<dir>]
#   poc/lab/bin/measure-ladder --scenario=<t-1..t-5> --dry-run [--predictions=<file>] [--out=<dir>]
#
# One step = 6 minutes of constant arrival at one total rps, the first minute discarded (the kept window is 5 minutes). The steps
# are 0.05 0.07 0.1 0.15 0.2 0.3 0.45 0.7 1.0 1.5 2.2 3.3 5.0, from the bottom up. The count of the tables and the mix are the
# scenario's (t-1: 3 x N_0 even; t-2: 10 x N_0 even; t-3: 10 x N_0 first80; t-4: N_0 even; t-5: 10 x N_0 last80; N_0 = 10,000).
#
# Order of work:
#   1. THE GATE (poc/lab/bin/prediction-gate): the prediction file must be committed in HEAD and have no difference from HEAD.
#      If it cannot be confirmed this stops with exit 12, before the closed-network check and before any container is touched.
#   2. the closed-network check (bin/preflight, exit 11), then the app must read the scenario's scale.
#   3. each step: make-plan -> sample-cpu (DB and app, in the background) -> k6 -> summarize-run -> the record.
# The tools used are the lab's own: load/make-plan.php, load/scenario.js, load/summarize-run.php, observe/sample-cpu.
#
# The scale: `bin/build-db --scale=N --n-tables=entities,images,references` (once per scale; the 8 routes' N tables all become N)
# and `bin/targets --static=<analysis.json> --scale=N` (once per scale) are done before this; this tool only switches the app to the
# scale when `--switch-scale` is given (it runs `bin/use-db <N>`), and otherwise stops (exit 2) if the app reads another scale.
#
# Stopping (ruling 2): a step at 80% DB utilization or more, or whose rps did not come out (outside 5%), is measured and recorded
# and the scenario stops there. A step whose rps did not come out while the DB was under 80% is recorded as an app-side stall
# with the app's CPU utilization. Each step prints one line when it starts and one when it ends (RUNG START / RUNG END).
# Nothing is compared with the prediction here.
#
# Records: <out>/<scenario>-<scale>/rung-NN-<rps>/{plan,summary,record}.json, cpu.txt, app-cpu.txt, k6.log, started_at.txt,
# ended_at.txt; and <out>/<scenario>-<scale>/ladder.json (all the steps of the scenario). A step with a record.json already is not
# measured again (a restart goes on from the first step without one). Default <out>: $PEAK_LAB_OUT_DIR/ladder.
#
# --dry-run touches no container and sends no load: it makes the plan of every step (with make-plan), prints the table (the rate of
# each route, what the plan would count in the kept window, the longest the scenario can take) and says what the gate says. It
# does not enforce the gate (nothing is measured), and it needs PHP (on the host, or the dev image `peak-sim-php-dev:8.3`).
#
# exit codes: 0 the ladder was measured to its end or to its stopping step / 2 usage, or the app reads another scale, or a
# missing prerequisite / 11 not sealed / 12 the prediction gate is closed / 13 a step could not be measured (the cause is printed)
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lab.sh"
bindir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() { sed -n '2,5p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

scenario="" ; predictions="" ; dry=0 ; switch=0 ; out=""
for arg in "$@"; do
  case "$arg" in
    --scenario=*) scenario="${arg#--scenario=}" ;;
    --predictions=*) predictions="${arg#--predictions=}" ;;
    --out=*) out="${arg#--out=}" ;;
    --dry-run) dry=1 ;;
    --switch-scale) switch=1 ;;
    *) usage ;;
  esac
done
[[ "$scenario" =~ ^t-[1-5]$ ]] || usage
[ -n "$out" ] || out="$PEAK_LAB_OUT_DIR/ladder"
if [ "$dry" = 0 ] && [ -z "$predictions" ]; then
  echo "measure-ladder: --predictions=<the committed prediction file> is required (the gate)" >&2
  exit 2
fi

# 1. THE GATE. Nothing above this line touches a container; nothing below runs unless it is open. -------------------------
gate_line=""
if [ "$dry" = 0 ]; then
  gate_line="$("$bindir/prediction-gate" "$predictions")" || exit 12
  echo "$gate_line"
elif [ -n "$predictions" ]; then
  gate_line="$("$bindir/prediction-gate" "$predictions" 2>&1)" ; echo "gate (not enforced in a dry run): $gate_line"
else
  echo "gate (not enforced in a dry run): no prediction file was given; a measurement will not start without a committed one"
fi
pred_file="" ; pred_commit="" ; pred_time=""
if [ "$dry" = 0 ]; then
  read -r _ _ pred_file pred_commit pred_time <<<"$gate_line"
fi

# A PHP that does not touch the lab. In a dry run: the host's, else the dev image with no network. In a measurement: the tools
# container (it has the repository at /peak-sim and the out directory at /out; neither path is shared with the load's cores).
mkdir -p "$out"
out="$(cd "$out" && pwd)"
lab_out="$(cd "$PEAK_LAB_OUT_DIR" && pwd)"
case "$out" in "$lab_out"/*) ;; *) echo "measure-ladder: --out must be inside $lab_out (the tools container sees only that directory, as /out)" >&2; exit 2 ;; esac
in_container() { echo "/out/${1#"$lab_out"/}"; }   # host path under the out directory -> path inside the containers

php_tool() {  # php_tool <path of the script under the repository> [args...]
  local script="$1"; shift
  if [ "$dry" = 1 ]; then
    if command -v php >/dev/null 2>&1; then
      php "$PEAK_REPO_ROOT/$script" "$@"
    else
      docker run --rm --pull=never --network none --cpuset-cpus="${PEAK_DEV_CPUSET:-12-15}" -u "$(id -u):$(id -g)" -v "$PEAK_REPO_ROOT:/peak-sim:ro" -v "$lab_out:/out" \
        "${PEAK_DEV_IMAGE:-peak-sim-php-dev:8.3}" php "/peak-sim/$script" "$@"
    fi
  else
    docker exec -i peak-lab-tools php "/peak-sim/$script" "$@"
  fi
}
# Arguments that are paths under the out directory are given as host paths and rewritten for the container.
host_or_container() { if [ "$dry" = 1 ] && command -v php >/dev/null 2>&1; then echo "$1"; else in_container "$1"; fi; }
routes_path() { if [ "$dry" = 1 ] && command -v php >/dev/null 2>&1; then echo "$PEAK_REPO_ROOT/poc/lab/routes/route-list.json"; else echo "/peak-sim/poc/lab/routes/route-list.json"; fi; }

read -r scale mix < <(php_tool poc/lab/load/ladder.php scenario "$scenario" --line) || { echo "measure-ladder: cannot read the scenario table" >&2; exit 13; }
[ -n "${scale:-}" ] && [ -n "${mix:-}" ] || { echo "measure-ladder: cannot read the scenario table" >&2; exit 13; }
mapfile -t rungs < <(php_tool poc/lab/load/ladder.php rungs)
[ "${#rungs[@]}" -gt 0 ] || { echo "measure-ladder: cannot read the ladder" >&2; exit 13; }

sdir="$out/${scenario}-${scale}"
mkdir -p "$sdir"
duration=360 ; warmup=60

make_plan() {  # make_plan <rps> <file>
  php_tool poc/lab/load/make-plan.php --routes="$(routes_path)" --mix="$mix" --rps="$1" --duration=$duration --warmup=$warmup >"$2"
}

# --dry-run -------------------------------------------------------------------------------------------------------------------
if [ "$dry" = 1 ]; then
  echo "DRY RUN $scenario: scale $scale, mix $mix, ${#rungs[@]} steps, each $duration s with the first $warmup s discarded; no container is touched"
  i=0
  for rps in "${rungs[@]}"; do
    i=$((i + 1))
    d="$sdir/dry-run/rung-$(printf '%02d' "$i")-$rps"; mkdir -p "$d"
    make_plan "$rps" "$d/plan.json" || { echo "measure-ladder: make-plan failed for rps $rps (see above)" >&2; exit 13; }
  done
  php_tool poc/lab/load/ladder.php table --dir="$(host_or_container "$sdir/dry-run")" || exit 13
  echo "longest this scenario can take: ${#rungs[@]} steps x $((duration / 60)) min = $(( ${#rungs[@]} * duration / 60 )) min of load (+ about 1 min per step to start and read); it stops earlier at the first step at 80% DB utilization or with its rps not out"
  echo "plans are in $sdir/dry-run/"
  exit 0
fi

# 2. closed network, then the scale -----------------------------------------------------------------------------------------------
"$bindir/preflight" >/dev/null || { echo "measure-ladder: the closed-network check failed; nothing was measured" >&2; exit 11; }
targets="$lab_out/targets-$scale.json"
[ -f "$targets" ] || { echo "measure-ladder: $targets is missing (make it with: bin/targets --static=<analysis.json> --scale=$scale)" >&2; exit 2; }
app_scale="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' peak-lab-app 2>/dev/null | sed -n 's/^PEAK_LAB_SCALE=//p')"
if [ "$app_scale" != "$scale" ]; then
  if [ "$switch" = 1 ]; then
    echo "switching the app to scale $scale (it read ${app_scale:-nothing}) with bin/use-db"
    "$bindir/use-db" "$scale" || { echo "measure-ladder: bin/use-db $scale failed" >&2; exit 2; }
  else
    echo "measure-ladder: the app reads scale ${app_scale:-?}, this scenario needs $scale (run bin/use-db $scale, or give --switch-scale)" >&2
    exit 2
  fi
fi

# 3. the steps ----------------------------------------------------------------------------------------------------------------------
i=0
for rps in "${rungs[@]}"; do
  i=$((i + 1))
  d="$sdir/rung-$(printf '%02d' "$i")-$rps"
  if [ -f "$d/record.json" ]; then
    php_tool poc/lab/load/ladder.php decision "$(in_container "$d/record.json")" >/dev/null; rc=$?
    echo "RUNG SKIP $scenario rung $i rps $rps: already recorded"
    [ "$rc" = 6 ] && { echo "the scenario stopped after rung $i (recorded)"; break; }
    continue
  fi
  rm -rf "$d"; mkdir -p "$d"
  make_plan "$rps" "$d/plan.json" || { echo "measure-ladder: make-plan failed for rps $rps" >&2; exit 13; }
  started_epoch="$(date +%s)"; started_at="$(date -Iseconds)"; echo "$started_at" >"$d/started_at.txt"
  echo "RUNG START $scenario rung $i of ${#rungs[@]} rps $rps scale $scale mix $mix at $started_at (6 min)"

  # The samplers stop themselves (--seconds): the kept window ends at k6's own start + $duration s, and k6 starts a few seconds
  # after this line, so they run $duration + 60 s. Nothing is killed.
  "$bindir/../observe/sample-cpu" --container=peak-lab-db --out="$d/cpu.txt" --seconds=$((duration + 60)) 2>"$d/sampler.err" &
  db_pid=$!
  "$bindir/../observe/sample-cpu" --container=peak-lab-app --out="$d/app-cpu.txt" --seconds=$((duration + 60)) 2>>"$d/sampler.err" &
  app_pid=$!
  sleep 5   # a sample before the load starts, so the window's first edge is covered
  docker exec -e "PLAN=$(in_container "$d/plan.json")" -e "TARGETS=/out/targets-$scale.json" -e "SUMMARY=$(in_container "$d/summary.json")" \
    peak-lab-k6 k6 run /load/scenario.js >"$d/k6.log" 2>&1
  k6_rc=$?
  echo "$k6_rc" >"$d/k6.exit"
  wait "$db_pid"; db_rc=$?; wait "$app_pid"; app_rc=$?
  ended_at="$(date -Iseconds)"; echo "$ended_at" >"$d/ended_at.txt"
  echo "$db_rc $app_rc" >"$d/sampler.exit"
  # k6 exits 99 when a threshold fails; the thresholds here are all count>=0, so any non-zero exit is a real failure
  if [ "$k6_rc" != 0 ] || [ ! -f "$d/summary.json" ]; then
    echo "measure-ladder: k6 failed at rung $i (rps $rps), exit $k6_rc; see $d/k6.log. Stopped; nothing was judged." >&2
    exit 13
  fi
  if [ "$db_rc" != 0 ] || [ "$app_rc" != 0 ]; then
    echo "measure-ladder: a sampler failed at rung $i (DB $db_rc, app $app_rc); see $d/sampler.err. Stopped; no instantaneous figure is used instead." >&2
    exit 13
  fi
  php_tool poc/lab/load/summarize-run.php --plan="$(in_container "$d/plan.json")" --k6-summary="$(in_container "$d/summary.json")" \
    --samples="$(in_container "$d/cpu.txt")" --app-samples="$(in_container "$d/app-cpu.txt")" --app-cpus=6 >"$d/run.json" 2>"$d/summarize.err" || {
    echo "measure-ladder: summarize-run failed at rung $i: $(cat "$d/summarize.err"). Stopped." >&2; exit 13; }
  php_tool poc/lab/load/ladder.php record --scenario="$scenario" --rung="$i" --summary="$(in_container "$d/run.json")" \
    --started="$started_at" --ended="$ended_at" --prediction-file="$pred_file" --prediction-commit="$pred_commit" --prediction-time="$pred_time" \
    >"$d/record.json" 2>"$d/end-line.txt"; rc=$?
  cat "$d/end-line.txt"
  if [ "$rc" != 0 ] && [ "$rc" != 6 ]; then
    rm -f "$d/record.json"
    echo "measure-ladder: the record of rung $i could not be made (exit $rc)" >&2
    exit 13
  fi
  [ "$rc" = 6 ] && { echo "the scenario $scenario stops after rung $i"; break; }
done

php_tool poc/lab/load/ladder.php collect --dir="$(in_container "$sdir")" >"$sdir/ladder.json" && echo "ladder record: $sdir/ladder.json"
exit 0
