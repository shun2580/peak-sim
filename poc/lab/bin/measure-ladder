#!/usr/bin/env bash
# Measures one prediction scenario (t-1 .. t-5, r-1 .. r-5 of the re-check, or s-1 .. s-5 of the third backtest) on the lab, step by step up the rps ladder
# (docs/simulator-spec.md sections 7.2, 7.4.1 and 7.4.2).
#
#   poc/lab/bin/measure-ladder --scenario=<t-1..t-5|r-1..r-5|s-1..s-5> --predictions=<poc/lab/predictions/....json> --statement-record=<capture.json> [--scale=<N>] [--switch-scale] [--scheme=<spec|A|B>] [--request-timeout=<k6 duration>] [--require-allocation] [--max-steps=<N>] [--out=<dir>]
#   poc/lab/bin/measure-ladder --scenario=<t-1..t-5|r-1..r-5|s-1..s-5> --dry-run [--predictions=<file>] [--scale=<N>] [--scheme=<spec|A|B>] [--out=<dir>]
#   poc/lab/bin/measure-ladder --trial=<cal-2|cal-3> --statement-record=<capture.json> [--dry-run] [--switch-scale] [--scheme=<spec|A|B>] [--out=<dir under out/trial>]
#
# One step = 6 minutes of constant arrival at one total rps, the first minute discarded (the kept window is 5 minutes). That is the
# scheme `spec`, the default and the spec as written. `--scheme` chooses how a step is laid out in time, in one place
# (poc/runtime/src/LabLoad/LadderShape.php): `A` keeps the 5-minute window and starts each route's stream at its own time so that
# each route has a chosen whole number of requests in the window and the total is exactly the decided rps x the window; `B` also
# lengthens the window to the smallest multiple of 40 / rps that is at least 300 s. The stopping rule, the 5% check and the gate do
# not depend on the scheme. The steps
# are 0.05 0.07 0.1 0.15 0.2 0.3 0.45 0.7 1.0 1.5 2.2 3.3 5.0, from the bottom up (s-1 .. s-5, section 7.4.2, have 0.025 and 0.035 under the lowest: 15 steps). The count of the tables and the mix are the
# scenario's (t-1: 3 x N_0 even; t-2: 10 x N_0 even; t-3: 10 x N_0 first80; t-4: N_0 even; t-5: 10 x N_0 last80;
# r-1: 5 x N_0 even; r-2: 5 x N_0 first80; r-3: 20 x N_0 even; r-4: 20 x N_0 first80; r-5: 20 x N_0 last80;
# s-1: 30 x N_0 even; s-2: 30 x N_0 first80; s-3: 30 x N_0 last80; s-4: 30 x N_0 places1235; s-5: 30 x N_0 places1345; N_0 = 10,000).
#
# --request-timeout=<k6 duration> (for example 600s) is passed to the load tool as REQUEST_TIMEOUT, so that k6 does not cut a slow
# response before the server's own limits (k6's own default is 60 s). It is REQUIRED for r-1 .. r-5 and s-1 .. s-5 (sections 7.4.1 and 7.4.2 measure with the
# PHP limit off and 600 s here, so the value is stated, not left to a default); for t-1 .. t-5 and the trial, without it the load is
# sent exactly as before. The value is written into each step's record next to the other two limits (below).
#
# Order of work:
#   1. THE GATE (poc/lab/bin/prediction-gate): the prediction file must be committed in HEAD and have no difference from HEAD.
#      If it cannot be confirmed this stops with exit 12, before the closed-network check and before any container is touched.
#   2. the closed-network check (bin/preflight, exit 11), then the app must read the scenario's scale.
#   3. each step: make-plan -> read the three limits (outside the window, before the samplers start) -> sample-cpu (DB and app, in
#      the background) -> k6 -> summarize-run -> the record.
# The three limits (section 7.4.1) are read in the containers at the start of every step (bin/check-limits) and kept in the step's
# directory (settings-nginx.txt, settings-fpm.txt, settings-ini.txt, settings.json) and in record.json under "settings": the PHP
# max_execution_time as a request through php-fpm sees it (poc/lab/diagnosis/ini-probe.php over FastCGI; `php -i` would show the CLI's
# value), the web server's fastcgi_read_timeout (`nginx -T`), and the timeout given to k6 (php-fpm's request_terminate_timeout
# from `php-fpm -tt` is kept beside them). A limit that cannot be read stops the scenario (exit 13) before the step is measured.
# THE LIMITS GUARD: for r-1 .. r-5 and s-1 .. s-5 the values must also be the ones B needs (max_execution_time 0, request_terminate_timeout 0,
# fastcgi_read_timeout >= --request-timeout), or the scenario stops with exit 13 at that step and nothing is measured. t-1 .. t-5 and
# a trial are read and recorded only, as before.
# THE MEMORY GUARD (B is measured with PHP's memory_limit at 4G, decisions.md D206 and D208): bin/check-oom reads the app container's
#   State.OOMKilled, RestartCount, StartedAt and its cgroup's oom / oom_kill counters. The baseline is taken once the app reads the scenario's scale
#   (<scenario>/oom-baseline.txt), and the reading is compared with it before every step starts (OOM-BEFORE) and again as soon as k6 and the samplers have
#   stopped (OOM-AFTER; <step>/oom-after.txt). If anything changed the scenario stops with exit 19 at that step, the step is not judged and has no
#   record, and <step>/oom-stop.txt says which step it was. A reading that cannot be made stops it too. A memory limit that PHP itself reports
#   ("Allowed memory size exhausted") is not this: it shows in the step's HTTP status counts.
# THE MEMORY RECORD (decisions.md D210; a record only, it stops nothing): the app container has a memory limit of its own (lab.compose.yaml), and bin/read-memory
#   writes down the WSL machine's MemAvailable, the app container's memory.current / memory.peak / memory.max and the oom / oom_kill counters of the app and the
#   database containers, once at the scenario's baseline (MEM-BASELINE; <scenario>/mem-baseline.txt), before every step (MEM-BEFORE; <step>/mem-before.txt) and
#   just after k6 ends (MEM-AFTER; <step>/mem-after.txt). A reading that cannot be made is written as `unreadable`.
# THE WRITE GUARDS (lab-only rule: the lab may write the view-count table `views` and nothing else; decisions.md D187, D189). A dry run needs none.
#   (i)   bin/check-writes reads --statement-record (the capture's record of the statements of the eight routes) and stops with exit 15, before the
#         closed-network check and before any container is touched, unless every write in it is to `views` alone (line marked WRITE-CHECK).
#   (iii) bin/check-tables takes the count and CHECKSUM TABLE of the N tables at the start of the scenario (line marked TABLES-BEFORE; the
#         baseline is <scenario>/tables-before.tsv and is kept, so a restart is compared with the state the scenario began from) and again at its end
#         (TABLES-AFTER; <scenario>/tables-after.tsv), not between the steps: those two read every table whole and would change the buffer pool from
#         one step to the next (decisions.md D189). After every step, once k6 and the samplers have stopped, it compares only the server's own counters
#         of writes with the baseline (TABLES-STEP; <step>/writes-after.tsv): nothing is read from a table, and a write to a table other than `views`
#         stops the scenario at that step with exit 16 before the step is summarized, so the step has no record. A scale that has not been seen (not <= 30,000, 70,000 or 100,000) is refused with exit 17 before any
#         query unless --predictions is a committed prediction that holds a scenario of that scale.
# The count of the tables (the scale) of a scenario is the one the prediction file holds for that scenario (its `tables`, all of one value): with
# --predictions the tool reads it there, so a prediction made at another count than the table of load/ladder.php (for example B at 90,000) is
# measured at its own count. --scale=<N> is only a statement of what the caller expects: it must be the prediction's count, or the tool refuses
# (exit 2, before any container) and nothing is measured. A prediction file that holds no scenario of this name, or one whose tables are not of
# one count, is refused the same way. Only a dry run with no --predictions takes --scale (or, without it, the table's count) as it is.
# THE ALLOCATION (decisions.md D226 and D227): when the prediction file holds an `allocation` (a prediction made with `predict-ladder --drop-marked-routes`:
#   the routes marked at the scenario's count are taken out of the mix and their rps handed to the routes that stay), the load is sent that way: the
#   plan's shares are the scenario's `allocation.rps_after` (a route's rps over their sum) and a dropped route is not sent, so the measurement is the one
#   that was predicted. The line `ALLOCATION <scenario>: ...` says so, and `<scenario>-<count>/allocation.json` keeps what the plans were made from. A
#   prediction with no `allocation` anywhere is measured exactly as before (the mix; plans byte for byte the same). A prediction with half of one, or whose
#   `rps_after` disagrees with its stages or with the dropped routes, is refused with exit 2 before any container is touched.
#   --require-allocation (default off; the B chain sets it): a second guard behind the gate, which passes a prediction with no allocation as one made without
#   the flag. With it, a prediction that does not state an allocation for this scenario (the top block enabled and the scenario's own block; a prediction made with
#   the flag states both even when it drops no route) is refused with exit 2 before any container is touched, so a B that must be measured on an allocated mix
#   cannot be measured on the mix by a prediction that was made without it. Without the flag nothing changes. It needs --predictions and is refused with --trial.
# The tools used are the lab's own: load/make-plan.php, load/scenario.js, load/summarize-run.php, observe/sample-cpu.
#
# The scale: `bin/build-db --scale=N --n-tables=entities,images,references` (once per scale; the 8 routes' N tables all become N)
# and `bin/targets --static=<analysis.json> --scale=N` (once per scale) are done before this; this tool only switches the app to the
# scale when `--switch-scale` is given (it runs `bin/use-db <N>`), and otherwise stops (exit 2) if the app reads another scale.
#
# THE COUNT AND THE END OF A STEP (section 7.4.3): "did the decided rps come out" is counted on the requests SENT inside the kept window
# (load/scenario.js, lab_sent{phase:measure}), not on those that had finished by the window's end, and a step in which the load tool dropped
# any arrival (k6's dropped_iterations is not 0) is invalid. At the end of a step the load tool waits for the requests still running for as
# long as the request timeout (600 s; --request-timeout is also k6's graceful stop). The database work of a request that is still running at
# the window's end happens after the window and is outside the step's database utilization: the record says so (`end_of_step`, with the
# number of requests that finished after the window and the longest wait). The samplers stop on their own (below) and do not wait for it.
#
# Stopping (ruling 2): a step at 80% DB utilization or more, or whose rps did not come out (outside 5%) or with a dropped arrival, is measured and recorded
# and the scenario stops there. A step whose rps did not come out while the DB was under 80% is recorded as an app-side stall
# with the app's CPU utilization. Each step prints one line when it starts and one when it ends (RUNG START / RUNG END).
# Nothing is compared with the prediction here.
#
# Records: <out>/<scenario>-<scale>/rung-NN-<rps>/{plan,summary,record,settings}.json, cpu.txt, app-cpu.txt, k6-output.txt, started_at.txt,
# ended_at.txt, settings-*.txt, oom-before.txt, oom-after.txt, mem-before.txt, mem-after.txt (and oom-stop.txt when the memory guard stopped it; <scenario>/oom-baseline.txt and mem-baseline.txt) (no output is named *.log: the repository's .gitignore drops them, and a test checks every output name); and <out>/<scenario>-<scale>/ladder.json (all the steps of the scenario). A step with a record.json already is not
# measured again (a restart goes on from the first step without one). Default <out>: $PEAK_LAB_OUT_DIR/ladder.
#
# --dry-run touches no container and sends no load: it makes the plan of every step (with make-plan), prints the table (the rate of
# each route, what the plan would count in the kept window, the longest the scenario can take) and says what the gate says. It
# does not enforce the gate (nothing is measured), and it needs PHP (on the host, or the dev image `peak-sim-php-dev:8.3`).
#
# --trial is a dress rehearsal of this tool, NOT a measurement of a prediction scenario and never used to judge or calibrate:
# it takes a calibration mix only (cal-2 = first80, cal-3 = odd80; `even` is refused because at N_0 it is the prediction scenario
# t-4), at N_0 = 10,000, the one step R_0 = 1 rps, and it excludes --scenario and --predictions. It does not go through the
# prediction gate (there is no prediction in it); the gate of the ordinary path is untouched. Its records are always under
# <out dir>/trial/ (default and only place), named trial-<cal>-<scale>, and each record says "trial": true.
#
# --max-steps=<N> (1 to 99; default off, and then nothing changes) stops the scenario after its first N steps, whether they were measured now or were
# already recorded: a setting for a rehearsal of the tools (decisions.md D231), never for a measurement that is judged. It is not the stopping rule; the
# line `MAX-STEPS` says so, and the end-of-scenario table guard and the collection of the record run as for any scenario. Refused with --trial.
#
# exit codes: 0 the ladder was measured to its end or to its stopping step / 2 usage, or the app reads another scale, or a
# missing prerequisite / 11 not sealed / 12 the prediction gate is closed / 13 a step could not be measured (the cause is printed) /
# 15 a statement in the record writes outside `views` / 16 an N table changed / 17 a scale not seen yet and no committed prediction for it /
# 18 the N tables could not be read / 19 the app container was stopped for memory since the scenario's baseline (or could not be read): the memory guard
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lab.sh"
bindir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() { sed -n '5,7p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

scenario="" ; predictions="" ; dry=0 ; switch=0 ; out="" ; scheme=spec ; trial= ; request_timeout= ; statement_record= ; scale_arg= ; scale_given= ; require_allocation=0 ; max_steps= ; max_steps_given=
for arg in "$@"; do
  case "$arg" in
    --scenario=*) scenario="${arg#--scenario=}" ;;
    --predictions=*) predictions="${arg#--predictions=}" ;;
    --out=*) out="${arg#--out=}" ;;
    --dry-run) dry=1 ;;
    --switch-scale) switch=1 ;;
    --scheme=*) scheme="${arg#--scheme=}" ;;
    --trial=*) trial="${arg#--trial=}" ;;
    --request-timeout=*) request_timeout="${arg#--request-timeout=}" ;;
    --statement-record=*) statement_record="${arg#--statement-record=}" ;;
    --scale=*) scale_arg="${arg#--scale=}" ; scale_given=1 ;;
    --require-allocation) require_allocation=1 ;;
    --max-steps=*) max_steps="${arg#--max-steps=}" ; max_steps_given=1 ;;
    *) usage ;;
  esac
done
[[ "$scheme" =~ ^(spec|A|B)$ ]] || usage
if [ -n "$max_steps_given" ] && { ! [[ "$max_steps" =~ ^[1-9][0-9]?$ ]] || [ -n "$trial" ]; }; then
  echo "measure-ladder: --max-steps takes a whole number from 1 to 99 and is refused with --trial (got '$max_steps')" >&2
  exit 2
fi
if [ "$require_allocation" = 1 ] && { [ -n "$trial" ] || [ -z "$predictions" ]; }; then
  echo "measure-ladder: --require-allocation reads the allocation of a prediction: it needs --predictions and is refused with --trial" >&2
  exit 2
fi
# the same shape scenario.js accepts (a number alone would be milliseconds, so a unit is required)
if [ -n "$request_timeout" ] && ! [[ "$request_timeout" =~ ^[0-9]+(\.[0-9]+)?(ms|s|m|h)$ ]]; then
  echo "measure-ladder: --request-timeout must be a k6 duration with a unit, such as 600s (got '$request_timeout')" >&2
  exit 2
fi
if [ -n "$scale_given" ] && ! [[ "$scale_arg" =~ ^[1-9][0-9]{0,8}$ ]]; then
  echo "measure-ladder: --scale must be a whole number of rows (got '$scale_arg')" >&2
  exit 2
fi
if [ -n "$trial" ]; then
  # A trial is exclusive with a prediction scenario and with a prediction file; only the calibration mixes are accepted.
  if [ -n "$scenario" ] || [ -n "$predictions" ]; then
    echo "measure-ladder: --trial excludes --scenario and --predictions (a trial is never a prediction scenario)" >&2
    exit 2
  fi
  [[ "$trial" =~ ^cal-[23]$ ]] || { echo "measure-ladder: --trial takes cal-2 or cal-3 only (got '$trial')" >&2; exit 2; }
  [ -z "$scale_given" ] || { echo "measure-ladder: --trial is always at N_0; --scale is refused with it" >&2; exit 2; }
  scenario="trial-$trial"
  [ -n "$out" ] || out="$PEAK_LAB_OUT_DIR/trial"
else
  [[ "$scenario" =~ ^[trs]-[1-5]$ ]] || usage
  # the re-check measures with the limits stated: the load tool's timeout is never left to its default (section 7.4.1)
  if [[ "$scenario" =~ ^[rs]- ]] && [ "$dry" = 0 ] && [ -z "$request_timeout" ]; then
    echo "measure-ladder: $scenario needs --request-timeout=<k6 duration> (for example 600s): the re-check states it instead of leaving it to the load tool's default" >&2
    exit 2
  fi
  [ -n "$out" ] || out="$PEAK_LAB_OUT_DIR/ladder"
fi
if [ -z "$trial" ] && [ "$dry" = 0 ] && [ -z "$predictions" ]; then
  echo "measure-ladder: --predictions=<the committed prediction file> is required (the gate)" >&2
  exit 2
fi

# 1. THE GATE. Nothing above this line touches a container; nothing below runs unless it is open. -------------------------
gate_line=""
if [ -n "$trial" ]; then
  echo "trial $trial: a dress rehearsal of the tool at N_0, one step at R_0 = 1 rps; no prediction is involved, nothing here is used to judge or to calibrate"
elif [ "$dry" = 0 ]; then
  gate_line="$("$bindir/prediction-gate" "$predictions")" || exit 12
  echo "$gate_line"
elif [ -n "$predictions" ]; then
  gate_line="$("$bindir/prediction-gate" "$predictions" 2>&1)" ; echo "gate (not enforced in a dry run): $gate_line"
else
  echo "gate (not enforced in a dry run): no prediction file was given; a measurement will not start without a committed one"
fi
pred_file="" ; pred_commit="" ; pred_time=""
if [ "$dry" = 0 ] && [ -z "$trial" ]; then
  read -r _ _ pred_file pred_commit pred_time <<<"$gate_line"
fi

# 1a. THE COUNT OF THE SCENARIO. It is the prediction's: the `tables` of the scenario in the prediction file, all of one count. A --scale that
# differs from it is refused, and so is a file with no such scenario or with tables of different counts (the gate above is not loosened: this
# is a second check, on the count). Reads the file only; no container. A dry run with no prediction file has nothing to read it from.
scale_use=""
if [ -z "$trial" ] && [ -n "$predictions" ]; then
  scale_use="$(python3 - "$predictions" "$scenario" <<'PY'
import json, sys
path, sid = sys.argv[1], sys.argv[2]
def refuse(why):
    sys.stderr.write("measure-ladder: " + why + "\n")
    sys.exit(2)
try:
    with open(path) as fh:
        scenarios = json.load(fh).get("scenarios")
except Exception:
    refuse("cannot read %s as a prediction file (JSON)" % path)
rows = [s for s in scenarios if isinstance(s, dict) and s.get("id") == sid] if isinstance(scenarios, list) else []
if len(rows) != 1:
    refuse("the prediction file holds no scenario %s (or holds it more than once): the count it is measured at cannot be read from it" % sid)
tables = rows[0].get("tables")
counts = set(tables.values()) if isinstance(tables, dict) and tables else set()
if len(counts) != 1 or not all(isinstance(c, int) and not isinstance(c, bool) and c > 0 for c in counts):
    refuse("the tables of %s in the prediction file are not of one count (%s)" % (sid, json.dumps(tables)))
print(counts.pop())
PY
)" || exit 2
  if [ -n "$scale_arg" ] && [ "$scale_arg" != "$scale_use" ]; then
    echo "measure-ladder: --scale=$scale_arg disagrees with the prediction file, which holds $scenario at $scale_use rows; a prediction is measured at its own count, so nothing was measured" >&2
    exit 2
  fi
elif [ -z "$trial" ] && [ -n "$scale_arg" ]; then
  scale_use="$scale_arg"   # a dry run with no prediction file: the caller's count, as given
fi
[ -z "$scale_use" ] || echo "SCALE $scenario $scale_use rows$([ -z "$predictions" ] || echo " (the count of the prediction file)")"

# 1a'. THE ALLOCATION (decisions.md D226 and D227). A prediction made with `predict-ladder --drop-marked-routes` takes the routes that cannot run to the end
# at the scenario's count out of the mix and hands their rps to the routes that stay (its `allocation`, at the top and in each scenario). The load
# must be sent that way, or the measurement is not the one that was predicted: the shares of the plan are then the scenario's `allocation.rps_after`, not
# the mix's, and a dropped route is not sent. A prediction with no `allocation` anywhere (every earlier one) leaves this empty and the plan is made as
# it always was, byte for byte. A prediction that has one half of it (the top without the scenario's, the scenario's without the top's, a dropped route
# that still has an rps, an rps_after that is not what the stages hold) is refused (exit 2) before any container is touched. Reads the file only.
alloc_json=""
if [ -z "$trial" ] && [ -n "$predictions" ]; then
  alloc_json="$(python3 - "$predictions" "$scenario" "$require_allocation" <<'PY'
import json, math, sys
path, sid, require = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
def refuse(why):
    sys.stderr.write("measure-ladder: the allocation of %s in %s: %s\n" % (sid, path, why))
    sys.exit(2)
with open(path) as fh:
    doc = json.load(fh)
top = doc.get("allocation")
sc = [s for s in doc.get("scenarios", []) if isinstance(s, dict) and s.get("id") == sid][0]
alloc = sc.get("allocation")
on = isinstance(top, dict) and top.get("enabled") is True
if require and not (on and isinstance(alloc, dict)):
    refuse("--require-allocation: the prediction does not state an allocation for this scenario (the top block enabled and the scenario's own block, even with no route dropped); it was not made with predict-ladder --drop-marked-routes")
if alloc is None and not on:
    sys.exit(0)                                   # no allocation anywhere (or one that is off): the mix, as always
if alloc is not None and not on:
    refuse("the scenario has an allocation but the top of the file does not say it is on")
if not isinstance(alloc, dict):
    refuse("the top of the file says the allocation is on but the scenario has none")
after = alloc.get("rps_after")
if not isinstance(after, dict) or not after:
    refuse("no rps_after")
def positive(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v) and v > 0
if not all(isinstance(k, str) and positive(v) for k, v in after.items()):
    refuse("rps_after holds a route that is not a name or an rps that is not a positive number")
dropped = [d.get("route") for d in alloc.get("dropped_routes", []) if isinstance(d, dict)]
if any(r in after for r in dropped):
    refuse("a dropped route still has an rps in rps_after")
total = sum(after.values())
for key in ("rps_total_after", "rps_total_in_file"):
    if key in alloc and abs(alloc[key] - total) > 1e-6 * max(1.0, abs(total)):
        refuse("%s (%s) is not the sum of rps_after (%s)" % (key, alloc[key], total))
for j, st in enumerate(sc.get("stages", [])):
    rps = st.get("rps") if isinstance(st, dict) else None
    if not isinstance(rps, dict):
        continue
    if set(rps) != set(after):
        refuse("stage %d holds other routes than rps_after (%s)" % (j, sorted(set(rps) ^ set(after))))
    t = sum(rps.values())
    if t > 0 and any(abs(rps[r] / t - after[r] / total) > 1e-6 for r in after):
        refuse("stage %d does not have the shares of rps_after" % j)
json.dump({"rps_after": after, "dropped": dropped, "scenario": sid, "source": path}, sys.stdout, indent=2, sort_keys=True)
PY
)" || exit 2
  if [ -n "$alloc_json" ]; then
    echo "ALLOCATION $scenario: $(printf '%s' "$alloc_json" | python3 -c 'import json,sys; d=json.load(sys.stdin); print("%d routes sent, %d not sent (%s); the shares are the prediction'"'"'s rps_after, not the mix'"'"'s" % (len(d["rps_after"]), len(d["dropped"]), ", ".join(d["dropped"]) or "none"))')"
  fi
fi

# 1b. THE WRITE GUARD (i). Not in a dry run (nothing is measured). Nothing below touches a container until it has passed. ------------------------
if [ "$dry" = 0 ]; then
  [ -n "$statement_record" ] || { echo "measure-ladder: --statement-record=<capture.json> is required (the guard that the lab writes only views reads it)" >&2; exit 2; }
  "$bindir/check-writes" --statements="$statement_record"   # WRITE-CHECK
  write_rc=$?
  if [ "$write_rc" != 0 ]; then
    echo "measure-ladder: the write check did not pass (exit $write_rc); nothing was measured" >&2
    exit "$write_rc"
  fi
fi

# A PHP that does not touch the lab. In a dry run: the host's, else the dev image with no network. In a measurement: the tools
# container (it has the repository at /peak-sim and the out directory at /out; neither path is shared with the load's cores).
mkdir -p "$out"
out="$(cd "$out" && pwd)"
lab_out="$(cd "$PEAK_LAB_OUT_DIR" && pwd)"
case "$out" in "$lab_out"/*) ;; *) echo "measure-ladder: --out must be inside $lab_out (the tools container sees only that directory, as /out)" >&2; exit 2 ;; esac
if [ -n "$trial" ]; then
  case "$out" in "$lab_out"/trial|"$lab_out"/trial/*) ;; *) echo "measure-ladder: a trial's records go under $lab_out/trial only (got $out)" >&2; exit 2 ;; esac
else
  case "$out" in "$lab_out"/trial|"$lab_out"/trial/*) echo "measure-ladder: $lab_out/trial is for trials only" >&2; exit 2 ;; esac
fi
in_container() { echo "/out/${1#"$lab_out"/}"; }   # host path under the out directory -> path inside the containers

php_tool() {  # php_tool <path of the script under the repository> [args...]
  local script="$1"; shift
  if [ "$dry" = 1 ]; then
    if command -v php >/dev/null 2>&1; then
      php "$PEAK_REPO_ROOT/$script" "$@"
    else
      docker run --rm --pull=never --network none --cpuset-cpus="${PEAK_DEV_CPUSET:-12-15}" -u "$(id -u):$(id -g)" -v "$PEAK_REPO_ROOT:/peak-sim:ro" -v "$lab_out:/out" \
        "${PEAK_DEV_IMAGE:-peak-sim-php-dev:8.3}" php "/peak-sim/$script" "$@"
    fi
  else
    docker exec -i peak-lab-tools php "/peak-sim/$script" "$@"
  fi
}
# Arguments that are paths under the out directory are given as host paths and rewritten for the container.
host_or_container() { if [ "$dry" = 1 ] && command -v php >/dev/null 2>&1; then echo "$1"; else in_container "$1"; fi; }
routes_path() { if [ "$dry" = 1 ] && command -v php >/dev/null 2>&1; then echo "$PEAK_REPO_ROOT/poc/lab/routes/route-list.json"; else echo "/peak-sim/poc/lab/routes/route-list.json"; fi; }

tflag=() ; tname="$scenario"
if [ -n "$trial" ]; then tflag=(--trial) ; tname="$trial"; fi
scale_flag=(); [ -z "$scale_use" ] || scale_flag=(--scale="$scale_use")
read -r scale mix < <(php_tool poc/lab/load/ladder.php scenario "$tname" "${tflag[@]}" "${scale_flag[@]}" --line) || { echo "measure-ladder: cannot read the scenario table" >&2; exit 13; }
[ -n "${scale:-}" ] && [ -n "${mix:-}" ] || { echo "measure-ladder: cannot read the scenario table" >&2; exit 13; }
[ -z "$scale_use" ] || [ "$scale" = "$scale_use" ] || { echo "measure-ladder: the scenario table gave $scale rows, the prediction holds $scale_use; refusing" >&2; exit 13; }
# the steps of the scenario: the 15 of section 7.4.2 for s-1 .. s-5, the 13 of section 7.2 for t-* and r-* (a trial has its one step)
rungs_args=("${tflag[@]}"); [ -n "$trial" ] || rungs_args=(--scenario="$scenario")
mapfile -t rungs < <(php_tool poc/lab/load/ladder.php rungs "${rungs_args[@]}")
[ "${#rungs[@]}" -gt 0 ] || { echo "measure-ladder: cannot read the ladder" >&2; exit 13; }

sdir="$out/${scenario}-${scale}"
mkdir -p "$sdir"
if [ -n "$alloc_json" ]; then printf '%s\n' "$alloc_json" >"$sdir/allocation.json"; else rm -f "$sdir/allocation.json"; fi   # what the plans below are made from (kept with the scenario's records)
duration=360 ; warmup=60

# make_plan <rps> <file> <scheme>: the length of the step under the scheme (ladder.php shape), the plan (make-plan), then, for a
# staggered scheme, each route's start time (ladder.php stagger). Sets $duration and $warmup for this step.
make_plan() {
  local shape tmp
  shape="$(php_tool poc/lab/load/ladder.php shape --scheme="$3" --rps="$1")" || return 1
  read -r duration warmup <<<"$shape"
  local alloc_args=(); [ -z "$alloc_json" ] || alloc_args=(--allocation="$(host_or_container "$sdir/allocation.json")")
  php_tool poc/lab/load/make-plan.php --routes="$(routes_path)" --mix="$mix" --rps="$1" --duration="$duration" --warmup="$warmup" "${alloc_args[@]}" >"$2" || return 1
  if [ "$3" != spec ]; then
    tmp="$2.tmp"
    php_tool poc/lab/load/ladder.php stagger --scheme="$3" "$(host_or_container "$2")" >"$tmp" && mv "$tmp" "$2" || return 1
  fi
}

# --dry-run -------------------------------------------------------------------------------------------------------------------
if [ "$dry" = 1 ]; then
  echo "DRY RUN $scenario: scale $scale, mix $mix, ${#rungs[@]} steps; no container is touched. Selected scheme: $scheme (the table is printed for all three)"
  for sc in spec A B; do
    echo
    echo "scheme $sc$([ "$sc" = "$scheme" ] && echo ' (selected)')"
    i=0
    for rps in "${rungs[@]}"; do
      i=$((i + 1))
      d="$sdir/dry-run/$sc/rung-$(printf '%02d' "$i")-$rps"; mkdir -p "$d"
      make_plan "$rps" "$d/plan.json" "$sc" || { echo "measure-ladder: the plan failed for rps $rps, scheme $sc (see above)" >&2; exit 13; }
    done
    php_tool poc/lab/load/ladder.php table --dir="$(host_or_container "$sdir/dry-run/$sc")" || exit 13
  done
  echo
  echo "a step is its window + 60 s discarded; the scenario stops earlier at the first step at 80% DB utilization or with its rps not out (plus about 1 min per step to start and read)"
  echo "plans are in $sdir/dry-run/<scheme>/"
  exit 0
fi

# 2. closed network, then the scale -----------------------------------------------------------------------------------------------
"$bindir/preflight" >/dev/null || { echo "measure-ladder: the closed-network check failed; nothing was measured" >&2; exit 11; }

# THE WRITE GUARD (iii), the start of the scenario: the count and checksum of the N tables (the baseline is kept in the scenario's directory).
# A scale that has not been seen is refused here, before any query, unless the committed prediction holds a scenario of that scale.
tables_args=(--scale="$scale" --baseline="$sdir/tables-before.tsv")
[ -z "$predictions" ] || tables_args+=(--prediction="$predictions")
"$bindir/check-tables" before "${tables_args[@]}"   # TABLES-BEFORE
tables_rc=$?
if [ "$tables_rc" != 0 ]; then echo "measure-ladder: the N tables guard stopped $scenario at its start (exit $tables_rc); nothing was measured" >&2; exit "$tables_rc"; fi
targets="$lab_out/targets-$scale.json"
[ -f "$targets" ] || { echo "measure-ladder: $targets is missing (make it with: bin/targets --static=<analysis.json> --scale=$scale)" >&2; exit 2; }
app_scale="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' peak-lab-app 2>/dev/null | sed -n 's/^PEAK_LAB_SCALE=//p')"
if [ "$app_scale" != "$scale" ]; then
  if [ "$switch" = 1 ]; then
    echo "switching the app to scale $scale (it read ${app_scale:-nothing}) with bin/use-db"
    "$bindir/use-db" "$scale" || { echo "measure-ladder: bin/use-db $scale failed" >&2; exit 2; }
  else
    echo "measure-ladder: the app reads scale ${app_scale:-?}, this scenario needs $scale (run bin/use-db $scale, or give --switch-scale)" >&2
    exit 2
  fi
fi

# THE MEMORY GUARD, the baseline: the app container as it is now (after any `bin/use-db`, which makes the container again). Outside every window.
"$bindir/check-oom" save "$sdir/oom-baseline.txt"   # OOM-BASELINE
oom_rc=$?
if [ "$oom_rc" != 0 ]; then echo "measure-ladder: the memory guard could not read the app container; nothing was measured" >&2; exit 19; fi
# THE MEMORY RECORD (a record only, D210): the machine's free memory and the app container's memory now, and the database container's oom counters. It stops nothing.
"$bindir/read-memory" "$sdir/mem-baseline.txt" --label="$scenario baseline" >/dev/null 2>&1   # MEM-BASELINE

# read_settings <dir>: the three limits right now, as the containers hold them, and (for r-1 .. r-5 and s-1 .. s-5) whether they are the ones B needs.
# That is bin/check-limits: it only reads (nginx -T and php-fpm -tt print the configuration; ini-probe.php is one request through
# php-fpm that opens no database connection) and it runs before the samplers start, so nothing of it is in a window. The raw outputs and
# settings.json are kept in the step's directory. A limit that cannot be worked out returns 1, and so does a lab that is not set for
# the measurement: the re-check is measured with PHP's max_execution_time and request_terminate_timeout at 0 and nginx's
# fastcgi_read_timeout at least --request-timeout (a switch that was forgotten would otherwise spend a scale that is seen once).
# t-1 .. t-5 and a trial are measured as before: read and recorded, not required to be anything.
read_settings() {
  local d="$1" need=none timeout_args=()
  [[ "$scenario" =~ ^[rs]- ]] && need=unlimited
  [ -z "$request_timeout" ] || timeout_args=(--request-timeout="$request_timeout")
  "$bindir/check-limits" --require="$need" "${timeout_args[@]}" --dir="$d" >"$d/check-limits.out" 2>"$d/check-limits.err"
}

# 3. the steps ----------------------------------------------------------------------------------------------------------------------
i=0
for rps in "${rungs[@]}"; do
  i=$((i + 1))
  d="$sdir/rung-$(printf '%02d' "$i")-$rps"
  if [ -f "$d/record.json" ]; then
    php_tool poc/lab/load/ladder.php decision "$(in_container "$d/record.json")" >/dev/null; rc=$?
    echo "RUNG SKIP $scenario rung $i rps $rps: already recorded"
    [ "$rc" = 6 ] && { echo "the scenario stopped after rung $i (recorded)"; break; }
    if [ -n "$max_steps" ] && [ "$i" -ge "$max_steps" ]; then echo "MAX-STEPS $scenario: stopped after rung $i (--max-steps=$max_steps, a rehearsal setting; this is not the stopping rule)"; break; fi
    continue
  fi
  rm -rf "$d"; mkdir -p "$d"
  make_plan "$rps" "$d/plan.json" "$scheme" || { echo "measure-ladder: the plan failed for rps $rps (scheme $scheme)" >&2; exit 13; }
  read_settings "$d" || { echo "measure-ladder: the limits (PHP, k6, web server) are not as $scenario needs them, or could not be read, at rung $i: $(cat "$d/check-limits.err" 2>/dev/null). Stopped; nothing was measured." >&2; exit 13; }
  echo "RUNG SETTINGS $scenario rung $i: $(tr '\n' ' ' <"$d/settings.json" | tr -s ' ')"
  # THE MEMORY GUARD, before the step (the samplers have not started): nothing may have happened to the app container since the baseline
  "$bindir/check-oom" compare "$sdir/oom-baseline.txt" --out="$d/oom-before.txt" --where="$scenario rung $i (rps $rps), before the step" 2>"$d/oom-stop.txt" >/dev/null   # OOM-BEFORE
  oom_rc=$?
  if [ "$oom_rc" != 0 ]; then cat "$d/oom-stop.txt" >&2; echo "measure-ladder: the app container was stopped for memory (or could not be read) before rung $i; nothing was measured at it" >&2; exit 19; fi
  rm -f "$d/oom-stop.txt"
  "$bindir/read-memory" "$d/mem-before.txt" --label="$scenario rung $i before the step" >/dev/null 2>&1   # MEM-BEFORE
  started_epoch="$(date +%s)"; started_at="$(date -Iseconds)"; echo "$started_at" >"$d/started_at.txt"
  echo "RUNG START $scenario rung $i of ${#rungs[@]} rps $rps scale $scale mix $mix scheme $scheme at $started_at ($((duration / 60)) min $((duration % 60)) s)"

  # The samplers stop themselves (--seconds): the kept window ends at k6's own start + $duration s, and k6 starts a few seconds
  # after this line, so they run $duration + 60 s. Nothing is killed.
  "$bindir/../observe/sample-cpu" --container=peak-lab-db --out="$d/cpu.txt" --seconds=$((duration + 60)) 2>"$d/sampler.err" &
  db_pid=$!
  "$bindir/../observe/sample-cpu" --container=peak-lab-app --out="$d/app-cpu.txt" --seconds=$((duration + 60)) 2>>"$d/sampler.err" &
  app_pid=$!
  sleep 5   # a sample before the load starts, so the window's first edge is covered
  k6_env=(-e "PLAN=$(in_container "$d/plan.json")" -e "TARGETS=/out/targets-$scale.json" -e "SUMMARY=$(in_container "$d/summary.json")")
  [ -z "$request_timeout" ] || k6_env+=(-e "REQUEST_TIMEOUT=$request_timeout")
  docker exec "${k6_env[@]}" peak-lab-k6 k6 run /load/scenario.js >"$d/k6-output.txt" 2>&1
  k6_rc=$?
  echo "$k6_rc" >"$d/k6.exit"
  "$bindir/read-memory" "$d/mem-after.txt" --label="$scenario rung $i just after k6" >/dev/null 2>&1   # MEM-AFTER
  wait "$db_pid"; db_rc=$?; wait "$app_pid"; app_rc=$?
  ended_at="$(date -Iseconds)"; echo "$ended_at" >"$d/ended_at.txt"
  echo "$db_rc $app_rc" >"$d/sampler.exit"
  # THE MEMORY GUARD, after the step (k6 and the samplers have stopped): the step's load must not have cost the app container a worker or the container
  "$bindir/check-oom" compare "$sdir/oom-baseline.txt" --out="$d/oom-after.txt" --where="$scenario rung $i (rps $rps), during or just after the step" 2>"$d/oom-stop.txt" >/dev/null   # OOM-AFTER
  oom_rc=$?
  if [ "$oom_rc" != 0 ]; then cat "$d/oom-stop.txt" >&2; echo "measure-ladder: the app container was stopped for memory at rung $i (rps $rps); the measurement is stopped, the step is not judged and has no record (see $d/oom-stop.txt)" >&2; exit 19; fi
  rm -f "$d/oom-stop.txt"
  # k6 exits 99 when a threshold fails; the thresholds here are all count>=0, so any non-zero exit is a real failure
  if [ "$k6_rc" != 0 ] || [ ! -f "$d/summary.json" ]; then
    echo "measure-ladder: k6 failed at rung $i (rps $rps), exit $k6_rc; see $d/k6-output.txt. Stopped; nothing was judged." >&2
    exit 13
  fi
  if [ "$db_rc" != 0 ] || [ "$app_rc" != 0 ]; then
    echo "measure-ladder: a sampler failed at rung $i (DB $db_rc, app $app_rc); see $d/sampler.err. Stopped; no instantaneous figure is used instead." >&2
    exit 13
  fi
  # THE WRITE GUARD (iii), after the step: the load and the samplers are over. Only the server's counters of writes are read (no table is read between
  # steps); nothing but `views` may have been written since the scenario began, or the step is not judged.
  "$bindir/check-tables" step "${tables_args[@]}" --out="$d/writes-after.tsv"   # TABLES-STEP
  tables_rc=$?
  if [ "$tables_rc" != 0 ]; then echo "measure-ladder: the write guard stopped $scenario after rung $i (exit $tables_rc); the step is not judged and has no record" >&2; exit "$tables_rc"; fi
  php_tool poc/lab/load/summarize-run.php --plan="$(in_container "$d/plan.json")" --k6-summary="$(in_container "$d/summary.json")" \
    --samples="$(in_container "$d/cpu.txt")" --app-samples="$(in_container "$d/app-cpu.txt")" --app-cpus=6 --require-sent=1 >"$d/run.json" 2>"$d/summarize.err" || {
    echo "measure-ladder: summarize-run failed at rung $i: $(cat "$d/summarize.err"). Stopped." >&2; exit 13; }
  if [ -n "$trial" ]; then record_args=(--trial="$trial"); else record_args=(--scenario="$scenario" --scale="$scale" --prediction-file="$pred_file" --prediction-commit="$pred_commit" --prediction-time="$pred_time"); fi
  php_tool poc/lab/load/ladder.php record "${record_args[@]}" --rung="$i" --summary="$(in_container "$d/run.json")" --settings="$(in_container "$d/settings.json")" \
    --started="$started_at" --ended="$ended_at" \
    >"$d/record.json" 2>"$d/end-line.txt"; rc=$?
  cat "$d/end-line.txt"
  if [ "$rc" != 0 ] && [ "$rc" != 6 ]; then
    rm -f "$d/record.json"
    echo "measure-ladder: the record of rung $i could not be made (exit $rc)" >&2
    exit 13
  fi
  [ "$rc" = 6 ] && { echo "the scenario $scenario stops after rung $i"; break; }
  if [ -n "$max_steps" ] && [ "$i" -ge "$max_steps" ]; then echo "MAX-STEPS $scenario: stopped after rung $i (--max-steps=$max_steps, a rehearsal setting; this is not the stopping rule)"; break; fi
done

# THE WRITE GUARD (iii), the end of the scenario (the last step, or the one it stopped at): the count and checksum of the N tables again, with the counters.
# Outside every measured window: the samplers and the load are over. A difference stops at exit 16 before the scenario's record is collected.
"$bindir/check-tables" after "${tables_args[@]}" --out="$sdir/tables-after.tsv"   # TABLES-AFTER
tables_rc=$?
if [ "$tables_rc" != 0 ]; then echo "measure-ladder: the N tables guard stopped $scenario at its end (exit $tables_rc); the scenario has no record" >&2; exit "$tables_rc"; fi
php_tool poc/lab/load/ladder.php collect --dir="$(in_container "$sdir")" >"$sdir/ladder.json" && echo "ladder record: $sdir/ladder.json"
exit 0
