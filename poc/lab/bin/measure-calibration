#!/usr/bin/env bash
# THE ONE ENTRY THAT MEASURES CALIBRATION RUNS on the lab (docs/simulator-spec.md sections 7.2 and 7.4.1). A calibration run is measured here and nowhere else.
#
#   poc/lab/bin/measure-calibration --estimate=<estimate dir> --run=<id>:<plan.json> [--run=<id>:<plan.json> ...] [--scale=10000] [--run-scale=<id>:<n> ...]
#       --measure=<id>[,<id>...] --request-timeout=<k6 duration> --statement-record=<capture.json> [--switch-scale] [--gate-tables=<a,b>] [--search-gate-advisory] [--out=<dir>]
#   poc/lab/bin/measure-calibration --estimate=<estimate dir> --run=<id>:<plan.json> ... --gate-only [--gate-tables=<a,b>] [--out=<dir>]
#
# --run names every run of the planned set (the plan of a run is what `load/make-plan.php` writes: one rate per route) and the count of rows it is
# measured at (--scale for all, --run-scale for one). The set is the one the fit will be made on: the gate looks at all of it, also at the runs that are
# not measured now (a run whose rps is still to be searched is given at the rps it is planned at). --measure says which of them are measured by this call.
#
# Order of work:
#   1. THE CALIBRATION GATE (poc/lab/scenarios/calibration-gate): from the plans, the counts of rows and the estimate alone, the degree to which the two
#      coefficients can be told apart for the whole set and for every set that leaves one run out. If any is below the threshold (0.5) this stops with
#      exit 14 before the closed-network check and before any container is touched. The degrees are printed and kept in <out>/calibration-gate.json.
#   2. per run: the closed-network check (exit 11), the app must read the run's scale, THE LIMITS GUARD (bin/check-limits --require=unlimited
#      --request-timeout=<value>; exit 13 and nothing measured if the lab is not as the measurement needs), the statistics of the run's database
#      (mysql.innodb_table_stats, before), the samplers of the database and of the app, k6, summarize-run, the statistics again (after).
#   2a. THE WRITE GUARDS (lab-only rule: the lab may write the view-count table `views` and nothing else; decisions.md D187, D189):
#      (i)   bin/check-writes reads --statement-record (the capture's record of the statements of the eight routes) and stops with exit 15, before the
#            closed-network check, unless every write in it is to `views` alone (line marked WRITE-CHECK);
#      (iii) bin/check-tables takes the count and CHECKSUM TABLE of the N tables of the run's database before the run (line marked TABLES-BEFORE; the
#            baseline is <run>/tables-before.tsv) and again after k6 and the samplers have stopped (TABLES-AFTER; <run>/tables-after.tsv). A difference
#            stops at exit 16 before the run is summarized, so no record.json is made. A scale that has not been seen (not <= 30,000, 70,000 or
#            100,000) is refused with exit 17 before any query: a calibration is never measured there.
#   The gate is a line of this file marked CALIBRATION-GATE. A test runs this script through with a set that cannot tell the coefficients apart and shows
#   that the load tool is never reached, and that the same script with that line taken out does reach it.
#
# Records: <out>/<id>/{plan.json, calibration-gate.json, limits.txt, settings*.txt|json, stats-before.tsv, started_at.txt, cpu.txt, app-cpu.txt, summary.json,
# k6-output.txt, ended_at.txt, stats-after.tsv, record.json}. record.json is the output of load/summarize-run.php (what `make-calibration-scenario` reads).
# No output is named *.log (the repository's .gitignore drops them, and a record that is not committed is lost); a test checks every output name.
# A run with a record.json already is not measured again. Default <out>: $PEAK_LAB_OUT_DIR/calibration.
#
# --gate-tables=<a,b> names the tables the gate counts rows of (its --tables). It goes to the gate and to nothing else. Without it the gate keeps its own
# default (entities,images,references), as it always has. It is for an estimate whose N-axis routes name a table that is not one of the app's tables (the
# Bagisto lab's shared copy names `n_shared`, decisions.md D264 decision 3): the estimate, the gate and the simulator read that name, while the guard that
# checks the N tables of the database (bin/check-tables) reads the real tables from PEAK_LAB_TABLES_FILE, whatever this option says.
#
# --search-gate-advisory makes the gate advisory for the search of a rate (decisions.md D270 decision 1: the gate in front of a search run is a reference and is
# not a reason to refuse the search). It is for the runs that search a rate R and for those only. The gate is still called with the same inputs and
# the same arithmetic, its degrees are printed and kept in <out>/calibration-gate.json (and in every run's directory), and if it refuses (exit 14) the
# entry prints `GATE ADVISORY ... refused ... goes on`, writes <out>/search-gate-advisory.txt (the flag, the gate's exit code, whether it passed, its smallest degree and the run left out, the threshold) and goes on to measure, instead
# of stopping at 14. Any other failure of the gate (an unreadable plan, an unusable estimate: 2, 11, 20..25) still stops the entry, flag or not. It is
# refused together with --gate-only (usage error, exit 2, before the gate). Not for the calibration itself, the rehearsal or the measurement: the gate
# that counts is called after R is decided, with the real plans, and without this flag.
#
# --gate-only runs the gate and nothing else (no container is touched). The scale of a database is built before this (bin/build-db, bin/targets) and
# its statistics are made with ANALYZE (decisions.md D181); this entry only reads them.
#
# exit codes: 0 done / 2 usage or a missing prerequisite / 11 not sealed / 13 the limits are not as needed, or a run could not be measured /
# 14 the calibration gate refused / 15 a statement in the record writes outside `views` / 16 an N table changed / 17 a scale not seen yet /
# 18 the N tables could not be read / the codes of calibration-gate for an unusable estimate or plan (20..25)
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/_lab.sh"
bindir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() { sed -n '4,6p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

estimate="" ; runs=() ; run_scales=() ; scale=10000 ; measure="" ; request_timeout="" ; switch=0 ; out="" ; gate_only=0 ; statement_record= ; gate_tables= ; search_gate_advisory=0
for arg in "$@"; do
  case "$arg" in
    --estimate=*) estimate="${arg#--estimate=}" ;;
    --run=*) runs+=("${arg#--run=}") ;;
    --run-scale=*) run_scales+=("${arg#--run-scale=}") ;;
    --scale=*) scale="${arg#--scale=}" ;;
    --measure=*) measure="${arg#--measure=}" ;;
    --request-timeout=*) request_timeout="${arg#--request-timeout=}" ;;
    --switch-scale) switch=1 ;;
    --out=*) out="${arg#--out=}" ;;
    --gate-only) gate_only=1 ;;
    --gate-tables=*) gate_tables="${arg#--gate-tables=}" ;;
    --search-gate-advisory) search_gate_advisory=1 ;;
    --statement-record=*) statement_record="${arg#--statement-record=}" ;;
    *) usage ;;
  esac
done
[ -n "$estimate" ] && [ "${#runs[@]}" -gt 0 ] || usage
[[ "$scale" =~ ^[0-9]+$ ]] || usage
if [ -n "$gate_tables" ] && ! [[ "$gate_tables" =~ ^[a-z0-9_]+(,[a-z0-9_]+)*$ ]]; then
  echo "measure-calibration: --gate-tables must be table names (lower case, digits, _) separated by commas (got '$gate_tables')" >&2
  exit 2
fi
if [ "$search_gate_advisory" = 1 ] && [ "$gate_only" = 1 ]; then
  echo "measure-calibration: --search-gate-advisory cannot be given with --gate-only (the flag lets a refused gate go on to a measurement; --gate-only measures nothing)" >&2
  exit 2
fi
if [ "$gate_only" = 0 ]; then
  [ -n "$measure" ] || { echo "measure-calibration: --measure=<id>[,<id>...] says which runs are measured (or give --gate-only)" >&2; exit 2; }
  # the limits are stated, never left to the load tool's default (the calibration is measured with the limits off, section 7.4.1)
  [ -n "$request_timeout" ] || { echo "measure-calibration: --request-timeout=<k6 duration> (for example 600s) is required: the calibration states it" >&2; exit 2; }
fi
if [ -n "$request_timeout" ] && ! [[ "$request_timeout" =~ ^[0-9]+(\.[0-9]+)?(ms|s|m|h)$ ]]; then
  echo "measure-calibration: --request-timeout must be a k6 duration with a unit, such as 600s (got '$request_timeout')" >&2
  exit 2
fi
ids=() ; plans=()
for r in "${runs[@]}"; do
  id="${r%%:*}"; p="${r#*:}"
  [[ "$id" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] && [ "$p" != "$r" ] && [ -f "$p" ] || { echo "measure-calibration: --run=<id>:<plan.json> must name a plan that can be read (got '$r')" >&2; exit 2; }
  ids+=("$id"); plans+=("$p")
done
for m in ${measure//,/ }; do
  case " ${ids[*]} " in *" $m "*) ;; *) echo "measure-calibration: --measure names a run that is not in --run: $m" >&2; exit 2 ;; esac
done

lab_out="$(cd "$PEAK_LAB_OUT_DIR" && pwd)"
[ -n "$out" ] || out="$lab_out/calibration"
mkdir -p "$out"
out="$(cd "$out" && pwd)"
case "$out" in "$lab_out"/*) ;; *) echo "measure-calibration: --out must be inside $lab_out (the tools container sees only that directory, as /out)" >&2; exit 2 ;; esac
in_container() { echo "/out/${1#"$lab_out"/}"; }   # host path under the out directory -> path inside the containers

scale_of() {  # the count of rows of run $1
  local s v
  for s in "${run_scales[@]}"; do [ "${s%%:*}" = "$1" ] && v="${s#*:}"; done
  echo "${v:-$scale}"
}

# 1. THE CALIBRATION GATE. Nothing above this line touches a container; nothing below runs unless it is open. ----------------------------------
gate_args=(--estimate="$estimate" --scale="$scale" --out="$out/calibration-gate.json")
[ -z "$gate_tables" ] || gate_args+=(--tables="$gate_tables")   # to the gate only: bin/check-tables below reads the real N tables from PEAK_LAB_TABLES_FILE
for s in "${run_scales[@]}"; do gate_args+=(--run-scale="$s"); done
for i in "${!ids[@]}"; do gate_args+=(--run="${ids[$i]}:${plans[$i]}"); done
"$bindir/../scenarios/calibration-gate" "${gate_args[@]}"   # CALIBRATION-GATE
gate_rc=$?
if [ "$gate_rc" != 0 ] && { [ "$search_gate_advisory" = 0 ] || [ "$gate_rc" != 14 ]; }; then
  echo "measure-calibration: the calibration gate did not open (exit $gate_rc); nothing was measured" >&2
  exit "$gate_rc"
fi
if [ "$search_gate_advisory" = 1 ]; then   # GATE-ADVISORY: only a refusal (14) gets here with the flag; it is recorded, not hidden
  gate_json="$out/calibration-gate.json"   # the gate's own record: the smallest degree and the run left out that gives it, the threshold, whether it passed
  {
    printf 'search_gate_advisory=1\ngate_exit=%s\n' "$gate_rc"
    printf 'gate_passed=%s\n' "$(sed -n 's/^ *"passed": *\([a-z]*\),*$/\1/p' "$gate_json" | head -1)"
    printf 'min_degree=%s\n' "$(sed -n 's/^ *"min_degree": *\([0-9.eE+-]*\),*$/\1/p' "$gate_json" | head -1)"
    printf 'min_left_out=%s\n' "$(sed -n 's/^ *"min_left_out": *"\([^"]*\)",*$/\1/p' "$gate_json" | head -1)"
    printf 'threshold=%s\n' "$(sed -n 's/^ *"threshold": *\([0-9.eE+-]*\),*$/\1/p' "$gate_json" | head -1)"
    printf 'note=%s\n' "this run was made with --search-gate-advisory: a refused gate (14) did not stop it; it is a search run, not a calibration run"
  } >"$out/search-gate-advisory.txt"
  if [ "$gate_rc" = 14 ]; then
    echo "GATE ADVISORY: the calibration gate refused (exit 14) and --search-gate-advisory is given, so the search run goes on; the degrees are in $out/calibration-gate.json (decisions.md D270 decision 1)" >&2
  else
    echo "GATE ADVISORY: --search-gate-advisory is given; the calibration gate opened (exit 0)"
  fi
fi
[ "$gate_only" = 1 ] && exit 0

# 1b. THE WRITE GUARD (i): the record of the statements must show no write outside `views`. Nothing below runs unless it passes. --------------
[ -n "$statement_record" ] || { echo "measure-calibration: --statement-record=<capture.json> is required (the guard that the lab writes only views reads it)" >&2; exit 2; }
"$bindir/check-writes" --statements="$statement_record"   # WRITE-CHECK
write_rc=$?
if [ "$write_rc" != 0 ]; then
  echo "measure-calibration: the write check did not pass (exit $write_rc); nothing was measured" >&2
  exit "$write_rc"
fi

# 2. closed network ------------------------------------------------------------------------------------------------------------------------
"$bindir/preflight" >/dev/null || { echo "measure-calibration: the closed-network check failed; nothing was measured" >&2; exit 11; }

php_tool() { docker exec -i ${PEAK_LAB_TOOLS_CONTAINER} php "/peak-sim/$1" "${@:2}"; }

# stats <scale> <file>: mysql.innodb_table_stats of the database of that scale (table, last_update, n_rows, clustered_index_size, sum_of_other_index_sizes).
# The clock of last_update is the database server's (UTC). A read that fails stops the run: the statistics are part of what a calibration records.
stats() {
  local db="peak_sim_measure_${PEAK_MEASURE_RUN_ID}_lab_$1"
  docker exec -e MYSQL_PWD="$PEAK_MEASURE_DB_ROOT_PASSWORD" ${PEAK_LAB_DB_CONTAINER} mysql -uroot -N -B \
    -e "SELECT table_name, last_update, n_rows, clustered_index_size, sum_of_other_index_sizes FROM mysql.innodb_table_stats WHERE database_name='${db}' ORDER BY table_name" >"$2" 2>"$2.err" && [ -s "$2" ]
}

for id in ${measure//,/ }; do
  for i in "${!ids[@]}"; do [ "${ids[$i]}" = "$id" ] && plan="${plans[$i]}"; done
  run_scale="$(scale_of "$id")"
  d="$out/$id"
  if [ -f "$d/record.json" ]; then echo "RUN SKIP $id: already recorded"; continue; fi
  duration="$(sed -n 's/.*"duration_sec": *\([0-9][0-9]*\).*/\1/p' "$plan" | head -1)"
  warmup="$(sed -n 's/.*"warmup_sec": *\([0-9][0-9]*\).*/\1/p' "$plan" | head -1)"
  [ -n "$duration" ] && [ -n "$warmup" ] || { echo "measure-calibration: the plan of $id has no duration_sec and warmup_sec" >&2; exit 2; }
  targets="$lab_out/targets-$run_scale.json"
  [ -f "$targets" ] || { echo "measure-calibration: $targets is missing (make it with: bin/targets --static=<analysis.json> --scale=$run_scale)" >&2; exit 2; }
  app_scale="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' ${PEAK_LAB_APP_CONTAINER} 2>/dev/null | sed -n 's/^PEAK_LAB_SCALE=//p')"
  if [ "$app_scale" != "$run_scale" ]; then
    if [ "$switch" = 1 ]; then
      echo "switching the app to scale $run_scale (it read ${app_scale:-nothing}) with bin/use-db"
      "$bindir/use-db" "$run_scale" || { echo "measure-calibration: bin/use-db $run_scale failed" >&2; exit 2; }
    else
      echo "measure-calibration: the app reads scale ${app_scale:-?}, $id needs $run_scale (run bin/use-db $run_scale, or give --switch-scale)" >&2
      exit 2
    fi
  fi
  rm -rf "$d"; mkdir -p "$d"
  cp "$plan" "$d/plan.json"; cp "$out/calibration-gate.json" "$d/calibration-gate.json"
  [ "$search_gate_advisory" = 0 ] || cp "$out/search-gate-advisory.txt" "$d/search-gate-advisory.txt"

  # THE WRITE GUARD (iii), before: the count and the checksum of the N tables. A scale that has not been seen is refused here, before any query.
  "$bindir/check-tables" before --scale="$run_scale" --baseline="$d/tables-before.tsv"   # TABLES-BEFORE
  tables_rc=$?
  if [ "$tables_rc" != 0 ]; then echo "measure-calibration: the N tables guard stopped $id before the run (exit $tables_rc); nothing was measured" >&2; exit "$tables_rc"; fi

  # THE LIMITS GUARD: PHP's max_execution_time 0, the pool's request_terminate_timeout 0, nginx's fastcgi_read_timeout at least --request-timeout.
  "$bindir/check-limits" --require=unlimited --request-timeout="$request_timeout" --dir="$d" >"$d/limits.txt" 2>"$d/check-limits.err" || {
    echo "measure-calibration: the limits are not as $id needs them, or could not be read: $(cat "$d/check-limits.err" 2>/dev/null). Stopped; nothing was measured." >&2; exit 13; }
  echo "RUN SETTINGS $id: $(cat "$d/limits.txt")"
  stats "$run_scale" "$d/stats-before.tsv" || { echo "measure-calibration: the statistics of the database of scale $run_scale could not be read: $(cat "$d/stats-before.tsv.err" 2>/dev/null). Stopped; nothing was measured." >&2; exit 13; }

  started_at="$(date -Iseconds)"; echo "$started_at" >"$d/started_at.txt"
  echo "RUN START $id scale $run_scale plan $(basename "$(dirname "$plan")")/$(basename "$plan") ($((duration / 60)) min, the first $warmup s discarded) at $started_at"
  # The samplers stop themselves (--seconds): the kept window ends at k6's own start + $duration s, and k6 starts a few seconds after this line.
  "$bindir/../observe/sample-cpu" --container=${PEAK_LAB_DB_CONTAINER} --out="$d/cpu.txt" --seconds=$((duration + 60)) 2>"$d/sampler.err" &
  db_pid=$!
  "$bindir/../observe/sample-cpu" --container=${PEAK_LAB_APP_CONTAINER} --out="$d/app-cpu.txt" --seconds=$((duration + 60)) 2>>"$d/sampler.err" &
  app_pid=$!
  sleep 5   # a sample before the load starts, so the window's first edge is covered
  docker exec -e "PLAN=$(in_container "$d/plan.json")" -e "TARGETS=/out/targets-$run_scale.json" -e "SUMMARY=$(in_container "$d/summary.json")" -e "REQUEST_TIMEOUT=$request_timeout" \
    ${PEAK_LAB_K6_CONTAINER} k6 run /load/scenario.js >"$d/k6-output.txt" 2>&1
  k6_rc=$?
  echo "$k6_rc" >"$d/k6.exit"
  wait "$db_pid"; db_rc=$?; wait "$app_pid"; app_rc=$?
  ended_at="$(date -Iseconds)"; echo "$ended_at" >"$d/ended_at.txt"
  echo "$db_rc $app_rc" >"$d/sampler.exit"
  if [ "$k6_rc" != 0 ] || [ ! -f "$d/summary.json" ]; then
    echo "measure-calibration: k6 failed in $id, exit $k6_rc; see $d/k6-output.txt. Stopped; nothing was judged." >&2
    exit 13
  fi
  if [ "$db_rc" != 0 ] || [ "$app_rc" != 0 ]; then
    echo "measure-calibration: a sampler failed in $id (DB $db_rc, app $app_rc); see $d/sampler.err. Stopped; no instantaneous figure is used instead." >&2
    exit 13
  fi
  # THE WRITE GUARD (iii), after: the load and the samplers are over. The N tables must be what they were, or this run is not judged.
  "$bindir/check-tables" after --scale="$run_scale" --baseline="$d/tables-before.tsv" --out="$d/tables-after.tsv"   # TABLES-AFTER
  tables_rc=$?
  if [ "$tables_rc" != 0 ]; then echo "measure-calibration: the N tables guard stopped $id after the run (exit $tables_rc); the run is not judged and no record was made" >&2; exit "$tables_rc"; fi
  php_tool poc/lab/load/summarize-run.php --plan="$(in_container "$d/plan.json")" --k6-summary="$(in_container "$d/summary.json")" \
    --samples="$(in_container "$d/cpu.txt")" --app-samples="$(in_container "$d/app-cpu.txt")" --app-cpus="$PEAK_LAB_APP_CPUS" >"$d/record.json" 2>"$d/summarize.err" || {
    rm -f "$d/record.json"; echo "measure-calibration: summarize-run failed in $id: $(cat "$d/summarize.err"). Stopped." >&2; exit 13; }
  stats "$run_scale" "$d/stats-after.tsv" || { echo "measure-calibration: the statistics after $id could not be read: $(cat "$d/stats-after.tsv.err" 2>/dev/null). The run is recorded; read them by hand." >&2; }
  echo "RUN END $id at $ended_at: record $d/record.json"
done
exit 0
