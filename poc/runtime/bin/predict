#!/usr/bin/env bash
# Puts a size into the cost formulas of bin/fit and prints the predictions (simulator-spec.md section 4).
#
#   bin/predict --fits=<fits.json from bin/fit> --at=<N> > predictions.json
#
# Reads the formulas only; touches no database and no app. Uses the PHP on this machine if there is one; otherwise a
# throwaway container of the already built PHP image, with no network and the file mounted read-only. The image is
# never pulled.
# exit codes: 0 done / 2 wrong usage or an unreadable input / 11 no PHP and no image
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
runtime="$(cd "$here/.." && pwd)"
usage="usage: bin/predict --fits=<fits.json> --at=<N> > predictions.json"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 0
fi

if command -v php >/dev/null 2>&1; then
  exec php "$here/inner/predict.php" "$@"
fi

fits=""
at=""
for arg in "$@"; do
  case "$arg" in
    --fits=*) fits="${arg#--fits=}" ;;
    --at=*) at="${arg#--at=}" ;;
    *) echo "bin/predict: unknown argument: $arg" >&2; echo "$usage" >&2; exit 2 ;;
  esac
done
if [ -z "$fits" ]; then echo "bin/predict: --fits is required" >&2; echo "$usage" >&2; exit 2; fi
if ! [[ "$at" =~ ^[1-9][0-9]*$ ]]; then echo "bin/predict: --at must be a positive integer" >&2; echo "$usage" >&2; exit 2; fi
if [ ! -f "$fits" ]; then echo "bin/predict: --fits is not a readable file" >&2; echo "$usage" >&2; exit 2; fi
fits="$(cd "$(dirname "$fits")" && pwd)/$(basename "$fits")"

image="${PEAK_PHP_IMAGE:-peak-measure-php:${PHP_VERSION:-8.3}}"
if ! docker image inspect "$image" >/dev/null 2>&1; then
  echo "bin/predict: no php on this machine and no image $image (build it with bin/stack build-image)" >&2
  exit 11
fi
exec docker run --rm --pull=never --network none --read-only \
  -v "$runtime:/runtime:ro" -v "$fits:/input/fits.json:ro" \
  "$image" php /runtime/bin/inner/predict.php --fits=/input/fits.json --at="$at"
