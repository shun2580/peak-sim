#!/usr/bin/env bash
# Measures a Laravel app's routes for real, at several data sizes, inside the sealed measurement stack, and prints
# how the query count grows. The entry point of the runtime proof of concept. Needs Docker; PHP is not needed here.
#
#   bin/measure --app=<dir> --static=<analysis.json> [options]
#
# 1. brings the sealed stack up (bin/stack up)         2. bin/preflight must pass                 (exit 11 otherwise)
# 3. runs the driver inside the container (bin/inner/measure.php)                                4. tears the stack down (the database volume stays unless --purge)
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# >>> app-key
# The run's APP_KEY, made from the run id (decided once per run, so the process that builds a database and the ones
# that measure share it). It is made up inside the sealed stack and protects nothing: the app, its data and the stack
# are all synthetic and thrown away. It is 32 bytes, in the form Laravel's AES-256 cipher takes.
peak_app_key_for_run() {
  local digest
  digest="$(printf 'peak-sim-measure-app-key:%s' "$1" | sha256sum | cut -c1-32)"
  printf 'base64:%s' "$(printf '%s' "$digest" | base64 | tr -d '\n')"
}
# <<< app-key

usage() {
  cat <<'TXT'
usage: bin/measure --app=<dir> --static=<analysis.json> [options]
  --app=<dir>            the target app (absolute path; mounted read-only, never modified; its vendor/ must exist)
  --static=<file>        the static analysis output of the app (peak-sim analyze --format=json), the map of routes
  --out=<dir>            where the run record is written (default: $PEAK_OUT_DIR, else ~/.cache/peak-measure/<project>)
  --expected=<file>      a fixtures/expected.json to put beside the static analysis and the measurement
  --data=generator       how the databases are filled: the tool's generator (default; any app)
  --data=seeder          the verification app's own seeder (only for fixtures/laravel-app)
  --scales=100,1000,10000   the sizes of the main sweep: one or more, strictly ascending (default 100,1000,10000); one size
                         alone gives no growth verdict (a log-log slope needs two), the counts per route are still recorded
  --only=<a>,<b>         measure only the routes whose uri contains one of these; a name that starts with = must equal the whole uri
  --base=N               generator only: rows of every table that is not scaled (default 5)
  --n-tables=<a>,<b>     generator only: these tables all grow to N together, in one database shared by every route (the way
                         a plan taken at scale builds its database); without it each route gets the database of its own scaled table
  --profile=<name>       generator only: app knowledge from profiles/<name>.php (column values, tables to skip); a result
                         reached with a profile is reported apart from one reached without
  --gate-bypass=on|off  on (default): a route that answers 403 is tried once more with every Gate check let through, and that
                         result is marked gate_bypass (a different value, not the same as a plain hit); off: the 403 is recorded as it is
  --request-timeout=N    seconds one request may run, 1 to 600 (default 20; a route that runs tens of thousands of queries
                         at the largest scale can need more; the one used is written in summary.json). One measurement
                         (the start of the app and its requests) may run 3 x N + 120 seconds
  --warm=on|off          on (default): each measurement is a warm-up, a cold and a warm request; off: warm-up and cold only
                         (the warm request is left out, a third of the time; the cold value, which decides, is the same)
  --keep-stack           leave the stack up afterwards (for looking around; tear it down with bin/stack down, add --purge to drop the volume)
  --purge                also remove the database volume when the run ends (without it the volume is kept: <project>_measure-dbdata);
                         not with --keep-stack
  --help                 this text
environment: PEAK_COMPOSE_PROJECT (default peak-measure), PHP_VERSION (default 8.3, the image the app runs in),
             PEAK_PHP_IMAGE (run in another, already built image; see bin/stack build-image)
exit codes:
   0  done
   2  wrong usage
  10  refused: a host, user, database name or statement outside the measurement database
  11  preflight failed, or the stack could not be brought up: the container may not be sealed
  12  the app could not be started
  13  a measurement database could not be built (migration, seeder, generator)
  14  a request changed the database and it could not be rebuilt clean
TXT
}

fail_usage() {
  echo "bin/measure: $1" >&2
  usage >&2
  exit 2
}

app="" static="" out="" expected="" data="generator" scales="100,1000,10000" only="" base="" ntables="" ntables_given=0 profile="" profile_given=0 gate="" timeout="" warm="" keep=0 purge=0
for arg in "$@"; do
  case "$arg" in
    --help|-h) usage; exit 0 ;;
    --app=*) app="${arg#--app=}" ;;
    --static=*) static="${arg#--static=}" ;;
    --out=*) out="${arg#--out=}" ;;
    --expected=*) expected="${arg#--expected=}" ;;
    --data=*) data="${arg#--data=}" ;;
    --scales=*) scales="${arg#--scales=}" ;;
    --only=*) only="${arg#--only=}" ;;
    --base=*) base="${arg#--base=}" ;;
    --n-tables=*) ntables="${arg#--n-tables=}"; ntables_given=1 ;;
    --profile=*) profile="${arg#--profile=}"; profile_given=1 ;;
    --gate-bypass=*) gate="${arg#--gate-bypass=}" ;;
    --request-timeout=*) timeout="${arg#--request-timeout=}" ;;
    --warm=*) warm="${arg#--warm=}" ;;
    --keep-stack) keep=1 ;;
    --purge) purge=1 ;;
    *) fail_usage "unknown argument: $arg" ;;
  esac
done

[ "$keep" = 1 ] && [ "$purge" = 1 ] && fail_usage "--purge cannot be combined with --keep-stack (--keep-stack leaves the whole stack up)"
[ -n "$app" ] || fail_usage "--app is required"
[ -n "$static" ] || fail_usage "--static is required"
case "$app" in /*) ;; *) fail_usage "--app must be an absolute path" ;; esac
case "$static" in /*) ;; *) fail_usage "--static must be an absolute path" ;; esac
case "$data" in generator|seeder) ;; *) fail_usage "--data takes generator or seeder" ;; esac
[[ "$scales" =~ ^[0-9]+(,[0-9]+)*$ ]] || fail_usage "--scales needs one or more comma-separated integers"
prev=0
IFS=',' read -r -a scale_list <<< "$scales"
for s in "${scale_list[@]}"; do
  [ "$s" -gt "$prev" ] 2>/dev/null || fail_usage "--scales must be positive and strictly ascending"
  prev="$s"
done
if [ -n "$base" ]; then [[ "$base" =~ ^[1-9][0-9]{0,3}$ ]] || fail_usage "--base must be a positive integer"; fi
if [ "$ntables_given" = 1 ]; then
  [[ "$ntables" =~ ^[a-z0-9_]+(,[a-z0-9_]+)*$ ]] || fail_usage "--n-tables takes table names (lowercase letters, digits and _) separated by commas"
  [ "$data" = generator ] || fail_usage "--n-tables is for --data=generator"
fi
if [ "$profile_given" = 1 ]; then [[ "$profile" =~ ^[a-z][a-z0-9_-]{0,30}$ ]] || fail_usage "--profile takes the name of a file in profiles/ (lowercase letters, digits, - and _)"; fi
if [ -n "$gate" ]; then case "$gate" in on|off) ;; *) fail_usage "--gate-bypass takes on or off" ;; esac; fi
if [ -n "$timeout" ]; then [[ "$timeout" =~ ^[0-9]{1,3}$ ]] && [ "$((10#$timeout))" -ge 1 ] && [ "$((10#$timeout))" -le 600 ] || fail_usage "--request-timeout must be 1 to 600 seconds"; fi
if [ -n "$warm" ]; then case "$warm" in on|off) ;; *) fail_usage "--warm takes on or off" ;; esac; fi
if [ -n "$only" ]; then [[ "$only" =~ ^[^,]+(,[^,]+)*$ ]] || fail_usage "--only needs at least one route"; fi
[ -d "$app" ] || fail_usage "--app is not a directory: $app"
[ -f "$app/vendor/autoload.php" ] || fail_usage "the app has no vendor/autoload.php (install its dependencies first)"
[ -f "$static" ] || fail_usage "--static is not a file: $static"
if [ -n "$expected" ]; then
  case "$expected" in /*) ;; *) fail_usage "--expected must be an absolute path" ;; esac
  [ -f "$expected" ] || fail_usage "--expected is not a file: $expected"
fi

export PEAK_APP_ROOT="$app"
[ -n "$out" ] && export PEAK_OUT_DIR="$out"
# shellcheck source=_stack.sh
source "$here/_stack.sh"
set +e   # _stack.sh turns -e on; the exit codes below are read, not fatal

cp "$static" "$PEAK_OUT_DIR/static.json" || { echo "bin/measure: cannot write to $PEAK_OUT_DIR" >&2; exit 2; }
inner=(--data="$data")
[ -n "$only" ] && inner+=(--only="$only")
[ -n "$base" ] && inner+=(--base="$base")
[ "$ntables_given" = 1 ] && inner+=(--n-tables="$ntables")
[ "$profile_given" = 1 ] && inner+=(--profile="$profile")
[ -n "$gate" ] && inner+=(--gate-bypass="$gate")
[ -n "$warm" ] && inner+=(--warm="$warm")
if [ -n "$expected" ]; then
  cp "$expected" "$PEAK_OUT_DIR/expected.json" || exit 2
  inner+=(--expected=/out/expected.json)
fi

refuse_if_kept_volume || exit 2
teardown() { [ "$keep" = 1 ] || stack_down "$purge" >/dev/null 2>&1; }
trap teardown EXIT
trap 'exit 130' INT TERM

if ! compose up -d --build --wait; then
  echo "bin/measure: the measurement stack could not be brought up" >&2
  exit 11
fi
if ! bash "$here/preflight"; then
  echo "bin/measure: preflight failed; nothing was measured" >&2
  exit 11
fi

# One APP_KEY for every process of this run. Passed by name (the value is read from this environment, so it is on no
# command line) and never printed.
PEAK_MEASURE_APP_KEY="$(peak_app_key_for_run "$PEAK_MEASURE_RUN_ID")"
export PEAK_MEASURE_APP_KEY
exec_env=(-e PEAK_MEASURE_STATIC_JSON=/out/static.json -e PEAK_MEASURE_SCALES="$scales" -e PEAK_MEASURE_APP_KEY)
[ -n "$timeout" ] && exec_env+=(-e PEAK_MEASURE_REQUEST_TIMEOUT="$timeout")
compose exec -T "${exec_env[@]}" \
  measure-php php /peak-sim/poc/runtime/bin/inner/measure.php "${inner[@]}"
code=$?

# Whatever the driver left behind (it drops its own databases; this covers a crash) is removed before the stack goes.
compose exec -T measure-php php /peak-sim/poc/runtime/bin/inner/cleanup.php >/dev/null 2>&1 || true
exit "$code"
